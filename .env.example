# Local development only. Inside Home Assistant the app gets its access
# automatically (SUPERVISOR_TOKEN) and none of this is used.
#
# HA_URL: your Home Assistant, e.g. http://homeassistant.local:8123
# HA_TOKEN: a long-lived access token (Profile → Security). It is full admin
#           over your home: keep it in .env, never commit it.
HA_URL=
HA_TOKEN=
PORT=8099
